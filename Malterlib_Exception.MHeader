Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Exception}"
{
	%Group "Exception"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Exception/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Exception true
	{
		&
		{
			MalterlibLibrary_Exception ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Exception;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Exception true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Exception true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Exception true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Exception;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_Exception "@('Test/*'->MakeAbsolute())"
	MalterlibTestDependencies_Malterlib_Exception "Lib_Malterlib_Concurrency"
}


%Target "Exe_MalterlibTests_NoMalterlib"
{
	!!PlatformFamily "Emscripten"
	!!PlatformFamily "Windows"
	Property.MalterlibDisableMalterlib true
	{
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
	}
	Target
	{
		BaseName "MalterlibTests_NoMalterlib"
	}
	%Group "Source"
	{
		%File "../../../Exception/Test/Test_Malterlib_Exception_StdLib.cpp"
	}
}
