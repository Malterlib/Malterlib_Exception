Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Exception}"
{
	%Group "Exception"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Exception/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Exception define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Exception"
	{
		!!MalterlibLibrary_Exception true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Exception define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Exception true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Exception"
	MalterlibTestFiles_Malterlib_Exception define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestDependencies_Malterlib_Exception define [type(CEntity)] = ["Lib_Malterlib_Concurrency"]
}


%Target "Exe_MalterlibTests_NoMalterlib"
{
	!!PlatformFamily "Emscripten"
	!!PlatformFamily "Windows"
	Property.MalterlibDisableMalterlib true
	{
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
	}
	Target
	{
		BaseName "MalterlibTests_NoMalterlib"
	}
	%Group "Source"
	{
		%File "../../../Exception/Test/Test_Malterlib_Exception_StdLib.cpp"
	}
}

Property
{
	MalterlibException_SupportStackTraces define bool = false // User(Debug)=true: Set to true to enable stack tracing for exceptions
}

Compile
{
	!!LanguageFamily ".NET"

	PreprocessorDefines += "DMibConfig_Exception_SupportStackTraces"
	{
		!!MalterlibException_SupportStackTraces true
	}
}

// C and C++ Settings
Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			CompileDialect "C"
		}
	}

	PreprocessorDefines += "DMibConfig_Exception_SupportStackTraces=1"
	{
		!!MalterlibException_SupportStackTraces true
	}
	PreprocessorDefines += "DMibConfig_Exception_SupportStackTraces=0"
	{
		!!MalterlibException_SupportStackTraces false
	}
}

